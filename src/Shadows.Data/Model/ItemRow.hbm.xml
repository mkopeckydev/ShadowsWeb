<?xml version="1.0" encoding="utf-8"?>
<hibernate-mapping assembly="Shadows.Data" namespace="Shadows.Data.Model" xmlns="urn:nhibernate-mapping-2.2">
  <class name="ItemRow" table="ItemRow" lazy="false" >
    <id name="Id">
      <generator class="identity" />
    </id>
    <property name="IdItem" column="IdItem" />
    <property name="IdCharacterClass" column="IdCharacterClass" />
    <property name="IdSkillLevel" column="IdSkillLevel" />
    <property name="InfoLevel" column="InfoLevel" />
    <property name="InfoCaption" column="InfoCaption" />
    <property name="InfoText" column="InfoText" />
    <property name="CharacterClass" not-null="false" update="false" insert="false" formula="(select CharacterClass.Caption FROM CharacterClass WHERE CharacterClass.Id = IdCharacterClass)" />
    <property name="SkillLevel" not-null="false" update="false" insert="false" formula="(select SkillLevel.Caption FROM SkillLevel WHERE SkillLevel.Id = IdSkillLevel)" />
  </class>
</hibernate-mapping>