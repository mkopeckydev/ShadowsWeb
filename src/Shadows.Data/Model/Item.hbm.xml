<?xml version="1.0" encoding="utf-8"?>
<hibernate-mapping assembly="Shadows.Data" namespace="Shadows.Data.Model" xmlns="urn:nhibernate-mapping-2.2">
  <class name="Item" table="Item" lazy="false" >
    <id name="Id">
      <generator class="identity" />
    </id>
    <property name="IdSkill" column="IdSkill" />
    <property name="ImageName" column="ImageName" />
    <property name="Caption" column="Caption" />
    <property name="SkillName" not-null="false" update="false" insert="false" formula="(select Skill.Caption FROM Skill WHERE Skill.Id = IdSkill)" />
  </class>
</hibernate-mapping>
